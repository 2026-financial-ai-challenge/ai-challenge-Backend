# Copy to .env and fill in real keys. Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 통화 시나리오는 ai/scenarios/library.py의 고정 시나리오에서 무작위로 고릅니다.
# true로 바꾸면 매 통화 전에 LLM이 시나리오를 새로 씁니다(생성 1회 + 검수 1회,
# 실패 시 최대 3회 재시도). 전화가 울리기까지 그만큼 더 기다립니다.
DYNAMIC_SCENARIO=false
# openai(기본) 또는 gemini. gemini로 두면 OPENAI_API_KEY 대신 GEMINI_API_KEY로
# 시나리오를 생성/검수합니다(Gemini의 OpenAI 호환 엔드포인트 사용, 무료 티어 가능).
# 통화 중 실시간 응답은 backend/.env의 CALL_LLM_PROVIDER가 따로 결정합니다.
SCENARIO_LLM_PROVIDER=openai
GEMINI_API_KEY=
# 비워두면 provider에 맞는 기본값(openai: gpt-4o-mini, gemini: gemini-3.5-flash-lite)을 씁니다.
# gemini-2.5-flash 이하 구형 모델과 "thinking" 계열(3.x 비-lite)은 응답 전 수십 초의
# 숨은 reasoning 토큰을 태워 시나리오 생성 타임아웃을 넘기므로 lite 계열만 쓸 것.
SCENARIO_GENERATOR_MODEL=gpt-4o-mini
SCENARIO_REVIEW_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=
# Premade voices work on the free plan. Library voices return 402.
# Korean default (Theo, warm call-center): CxErO97xpQgQXYmapDKX
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_RANDOM=false
# eleven_flash_v2_5가 한국어를 지원하는 가장 낮은 지연의 모델입니다.
# eleven_multilingual_v2는 음질이 좋지만 통화에는 지연이 큽니다.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# 0.3–0.45 sounds more human. Cloned voice id in ELEVENLABS_VOICE_ID overrides Theo.
# pcm_24000 is easy to play locally and close to telephony PCM.
# Swap to ulaw_8000 later for Twilio Media Streams.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_SAMPLE_RATE=24000

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
STT_SAMPLE_RATE=16000
STT_ENDPOINTING_MS=400
# 훈련자가 말을 마치고 상담원이 답하기까지의 최소 침묵 시간입니다.
# 체감 지연에 그대로 더해지므로 낮출수록 빠릅니다. 너무 낮추면 말을 끊습니다.
STT_UTTERANCE_END_MS=1000
