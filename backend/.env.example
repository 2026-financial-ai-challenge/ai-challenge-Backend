# Database used by FastAPI and Alembic
DATABASE_URL=

# Optional local PostgreSQL service in compose.yaml
LOCAL_DB_PASSWORD=local_dev_password

# Authentication
JWT_SECRET=
SMS_EXPOSE_DEV_CODE=false

# ClawOps calls and signup SMS
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_PHONE_NUMBER=
CLAWOPS_UNANNOUNCED_PHONE_NUMBER=
CLAWOPS_SMS_FROM=
PUBLIC_BASE_URL=
CLAWOPS_WEBHOOK_SIGNING_SECRET=

# AI
OPENAI_API_KEY=
# 시나리오 생성/검수용 OpenAI 모델. 통화 중 실시간 응답 모델과는 별개입니다.
OPENAI_MODEL=gpt-4o-mini
# openai(기본) 또는 gemini — 통화 중 실시간 응답의 1순위 provider.
# OPENAI_API_KEY와 GEMINI_API_KEY가 둘 다 설정돼 있으면, 1순위가
# 첫 토큰을 하나도 못 내고 실패할 때(크레딧 소진, 429, 장애 등)
# 자동으로 나머지 provider가 그 턴에 대신 답합니다. 통화 후 리포트
# 생성도 같은 방식으로 자동 대체됩니다(OpenAI 우선 고정).
# 이 파일 아래쪽 SCENARIO_LLM_PROVIDER와는 별개 — 그건 사전 시나리오 생성만 담당.
CALL_LLM_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 1차 모델이 계속 죽으면 순서대로 시도합니다.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_ATTEMPTS=2
# 통화 중 한 응답의 출력 상한. 비워 두면 provider에 맞춘 기본값을 씁니다
# (openai: 120, gemini: 512). Gemini는 숨은 thinking 토큰도 이 예산에서 까기
# 때문에 상한이 낮으면 본문이 비어 통화가 무음이 될 수 있습니다.
# thinking이 확실히 꺼진 걸 확인한 뒤에만 낮추십시오.
# CALL_MAX_TOKENS=
# Gemini가 눈에 보이는 첫 토큰 전에 태우는 숨은 reasoning 토큰을 끕니다.
# 빈 값으로 두면 이 설정을 보내지 않습니다.
GEMINI_THINKING_BUDGET=0
# 통화 한 건에서 LLM 없이 즉답할 수 있는 최대 횟수 (0이면 끔).
CALL_REFLEX_BUDGET=3

# ── 음성 파이프라인 (구 ai/.env, 2026-09-05 통합) ─────────────────────────
# 이 파일이 유일한 env 파일입니다. ai/.env를 다시 만들면 ai/config.py가
# 그걸 먼저 읽어 진입점마다 값이 갈리므로 만들지 마십시오.

ELEVENLABS_API_KEY=
# 비워 두면 시나리오별 목소리(ai/scenarios/library.py)를 씁니다.
# 값을 넣으면 모든 시나리오의 목소리를 덮어씁니다.
# 프리메이드 보이스만 무료 플랜에서 동작하고, 라이브러리 보이스는 402로
# 0바이트를 반환해 통화가 무음이 됩니다. 한국어 기본값(Theo): CxErO97xpQgQXYmapDKX
ELEVENLABS_VOICE_ID=
# true면 매 통화마다 무작위 보이스를 뽑아 시나리오별 배정이 무시됩니다.
ELEVENLABS_VOICE_RANDOM=false
# eleven_flash_v2_5가 한국어를 지원하는 가장 낮은 지연의 모델입니다.
# eleven_multilingual_v2는 음질이 좋지만 통화에는 지연이 큽니다.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# pcm_24000은 로컬 재생이 쉽고 통신망 PCM에 가깝습니다.
# Twilio Media Streams를 쓰게 되면 ulaw_8000으로 바꾸십시오.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_SAMPLE_RATE=24000
# stability/similarity_boost는 env가 아니라 ai/scenarios/types.py에 있습니다.

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
STT_SAMPLE_RATE=16000
STT_ENDPOINTING_MS=400
# 훈련자가 말을 마치고 상담원이 답하기까지의 최소 침묵 시간입니다.
# 체감 지연에 그대로 더해지므로 낮출수록 빠릅니다. 너무 낮추면 말을 끊습니다.
STT_UTTERANCE_END_MS=1000

# Call behavior
UNANNOUNCED_CALL_MIN_DELAY_SEC=1800
UNANNOUNCED_CALL_MAX_DELAY_SEC=3600
UNANNOUNCED_CALL_RETRY_DELAY_SEC=300
UNANNOUNCED_CALL_MAX_ATTEMPTS=2
# 고정 시나리오를 쓰면 시나리오 준비에 LLM 호출이 없습니다.
# true로 바꾸면 매 통화 전에 LLM이 시나리오를 새로 씁니다.
DYNAMIC_SCENARIO=false
# DYNAMIC_SCENARIO=true 일 때만 의미가 있습니다.
SCENARIO_GENERATION_TIMEOUT_SEC=20
# 시나리오 사전 생성 provider (ai/config.py가 읽습니다).
SCENARIO_LLM_PROVIDER=gemini
# 비워두면 provider에 맞는 기본값(openai: gpt-4o-mini, gemini: gemini-3.5-flash-lite)을 씁니다.
# gemini-2.5-flash 이하 구형 모델과 "thinking" 계열(3.x 비-lite)은 응답 전 수십 초의
# 숨은 reasoning 토큰을 태워 시나리오 생성 타임아웃을 넘기므로 lite 계열만 쓸 것.
# SCENARIO_LLM_PROVIDER=gemini일 때 아래가 gpt-* 이면 generator가 자동으로
# Gemini 기본 모델로 대체합니다(ai/scenarios/generator.py:_resolve_model).
SCENARIO_GENERATOR_MODEL=gpt-4o-mini
SCENARIO_REVIEW_MODEL=gpt-4o-mini

# 번호 확인 (OCTOMO) — app/services/octomo_service.py
OCTOMO_API_KEY=
OCTOMO_SEND_TO=16663538
