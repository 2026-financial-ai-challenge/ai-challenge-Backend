# 이 파일이 프로젝트의 유일한 env 파일입니다. ai/.env는 만들지 마십시오
# (ai/config.py가 그걸 먼저 읽어 진입점마다 값이 갈립니다).

# ── 서버 ────────────────────────────────────────────────────────────────
# Database used by FastAPI and Alembic
DATABASE_URL=
# Optional local PostgreSQL service in compose.yaml
LOCAL_DB_PASSWORD=local_dev_password
JWT_SECRET=
SMS_EXPOSE_DEV_CODE=false

# ── ClawOps: 발신 전화 · 가입 인증 문자 · 통화 웹훅 ─────────────────────────
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_PHONE_NUMBER=
CLAWOPS_UNANNOUNCED_PHONE_NUMBER=
CLAWOPS_SMS_FROM=
PUBLIC_BASE_URL=
CLAWOPS_WEBHOOK_SIGNING_SECRET=


# ── 통화 엔진 선택 ──────────────────────────────────────────────────────
# managed(기본): ClawOps 콘솔에서 만든 에이전트가 통화를 통째로 처리합니다.
#   프롬프트·지식·목소리가 전부 콘솔에 있고, 서버는 발신만 겁니다.
#   ai/scenarios와 app/training/은 이 모드에서 전혀 쓰이지 않습니다.
# realtime: Agent SDK로 OpenAI/Gemini realtime 모델이 응답합니다.
#   프롬프트는 ai/scenarios에서 나가고, 목소리는 CLAWOPS_VOICE를 씁니다.
# pipeline: 자체 파이프라인(Deepgram STT → LLM → ElevenLabs TTS)을 씁니다.
#   app/training/의 인사말 가드·에코 필터·반사 응답·턴 병합 로직이 이때만
#   동작합니다. DEEPGRAM_API_KEY와 ELEVENLABS_API_KEY가 둘 다 필요합니다.
# 세 경로 모두 코드가 살아 있으므로 이 값만 바꾸면 즉시 되돌릴 수 있습니다.
CALL_AGENT_MODE=managed

# managed 모드에서 쓸 콘솔 에이전트 ID 목록 (쉼표 구분).
# 시나리오별로 콘솔에 에이전트를 만들어 두고 여기 나열하면, 통화마다 하나를
# 무작위로 고릅니다. 직전 통화에 쓴 에이전트는 후보에서 빼므로, 예고 통화와
# 불시 통화가 같은 시나리오로 연달아 나가지 않습니다.
CLAWOPS_AGENT_IDS=
# managed 모드는 통화 종료를 status 웹훅으로 알게 됩니다. PUBLIC_BASE_URL이
# 비어 있으면 콜백 URL을 만들 수 없어 세션이 'calling'에 멈추고 불시 훈련도
# 예약되지 않습니다. (웹훅 경로: /v1/webhooks/clawops/status)

# realtime 모드에서 쓸 목소리. CALL_LLM_PROVIDER=openai면 CLAWOPS_VOICE,
# gemini면 CLAWOPS_GEMINI_VOICE가 쓰입니다. OpenAI/Gemini가 제공하는 preset
# 이름이며, 콘솔에서 만든 커스텀 보이스는 managed 모드에서만 쓸 수 있습니다.
CLAWOPS_VOICE=marin
CLAWOPS_GEMINI_VOICE=Kore


# ── Deepgram: 훈련자 음성 인식(STT) ──────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
# 훈련자가 말을 멈춘 뒤 발화가 끝났다고 판단하기까지의 침묵(ms).
# 매 턴 지연에 그대로 더해집니다. 너무 낮추면 말이 느린 사람의 문장을 끊습니다.
STT_ENDPOINTING_MS=300
STT_UTTERANCE_END_MS=1000


# ── OpenAI: 통화 중 실시간 응답 + 통화 후 리포트 ─────────────────────────
# 필수. 크레딧이 있는 유료 키여야 합니다(무료·소진 키는 429로 통화가 무음이 됩니다).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── ElevenLabs: 상담원 목소리(TTS) ───────────────────────────────────────
# 필수. 없으면 통화가 OpenAI Realtime 음성으로 떨어지고, 목소리 선택과
# 하네스(문장 검사)가 빠집니다.
ELEVENLABS_API_KEY=
# 비우면 시나리오별 목소리(ai/scenarios/library.py). 넣으면 모든 시나리오를 덮어씁니다.
# 무료 플랜에서는 프리메이드 보이스만 동작합니다(라이브러리 보이스는 무음).
ELEVENLABS_VOICE_ID=
# 실시간 대사용. 한국어 지원 모델 중 지연이 가장 낮습니다.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# 미리 합성하는 고정 대사용. 비우면 위와 같은 모델(음색 일관성 우선).
# eleven_multilingual_v2 / eleven_v3 는 더 자연스럽지만 실시간 대사와 음색 차이가 날 수 있습니다.
ELEVENLABS_PRERENDER_MODEL_ID=

# ── 통화 동작 ────────────────────────────────────────────────────────────
# 대본 모드: off | shadow(판단만 로그, 답은 LLM) | on(확실한 턴은 미리 합성한 대사로 즉답)
# shadow로 실통화를 모아 `python -m ai.script_eval --logs <로그>`로 적중률을 본 뒤 on으로 올리십시오.
CALL_SCRIPT_MODE=shadow
# 미리 합성한 음성 캐시 위치. 비우면 OS 임시 폴더. 배포에서는 볼륨 경로를 권장합니다.
TTS_CACHE_DIR=
# 비우면 고정 5편 중 무작위. 하나로 고정하려면 id. 예: investigation_unit
CALL_SCENARIO=

# 예고 없는 훈련 전화 스케줄
UNANNOUNCED_CALL_MIN_DELAY_SEC=1800
UNANNOUNCED_CALL_MAX_DELAY_SEC=3600
UNANNOUNCED_CALL_RETRY_DELAY_SEC=300
UNANNOUNCED_CALL_MAX_ATTEMPTS=2

# ── 선택: 튜닝 (비워 두면 코드 기본값) ────────────────────────────────────
# CALL_RESPONSE_DEBOUNCE_SEC=0.1   발화 확정 후 LLM 호출 전 대기(초)
# CALL_PRERENDER=true              벨이 울리는 동안 고정 대사 미리 합성
# CALL_REFLEX_BUDGET=3             한 통화에서 LLM 없이 즉답하는 최대 횟수
# CALL_MAX_SENTENCES=3             한 턴 최대 문장 수
# CALL_GUARD_MAX_VIOLATIONS=3      모델이 규칙을 이만큼 어기면 역할을 유지한 채 종료
# CALL_SAFETY_EXIT_LINE=           실제 위급 신호 시 역할을 멈추고 읽는 문장
# CALL_MAX_TOKENS=120              한 응답의 출력 토큰 상한
#
# 선택: Gemini를 OpenAI 장애 시 자동 대체로 쓰려면 키만 넣으십시오.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite   (docs/latency.md 측정 당시 유일하게 응답한 모델)
