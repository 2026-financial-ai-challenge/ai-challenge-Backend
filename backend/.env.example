# ── 서버 ────────────────────────────────────────────────────────────────
DATABASE_URL=
# compose.yaml의 로컬 PostgreSQL 비밀번호
LOCAL_DB_PASSWORD=local_dev_password

# 가입 인증(OTP·재발송 대기·인증 토큰) 저장소. compose면 redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
SMS_EXPOSE_DEV_CODE=false


# ── ClawOps: 발신 전화 · 문자 · 통화 웹훅 ───────────────────────────────
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_PHONE_NUMBER=
CLAWOPS_UNANNOUNCED_PHONE_NUMBER=
CLAWOPS_SMS_FROM=
CLAWOPS_WEBHOOK_SIGNING_SECRET=
# 상태 웹훅을 받을 공개 주소. 비어 있으면 세션이 'calling'에 머물고 불시 전화도 예약되지 않습니다.
PUBLIC_BASE_URL=

# ── 통화 에이전트 ───────────────────────────────────────────────────────
# 에이전트는 `python -m ai.managed_agent sync`로 만듭니다. 자세한 내용은 ai/MANAGED_AGENT.md
# external_tts(기본) | live | ab(통화마다 무작위)
CALL_AGENT_VARIANT=external_tts
# 비우면 고정 시나리오 중 무작위. 모든 통화를 하나로 고정하려면 id. 예: investigation_unit
CALL_SCENARIO=

# ── 리포트 채점 LLM ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# ── 통화 파이프라인용 ─────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
STT_SAMPLE_RATE=16000
STT_ENDPOINTING_MS=400
STT_UTTERANCE_END_MS=1000

# ── 불시 전화 ───────────────────────────────────────────────────────────
UNANNOUNCED_CALL_MIN_DELAY_SEC=1800
UNANNOUNCED_CALL_MAX_DELAY_SEC=3600
UNANNOUNCED_CALL_RETRY_DELAY_SEC=300
UNANNOUNCED_CALL_MAX_ATTEMPTS=2

