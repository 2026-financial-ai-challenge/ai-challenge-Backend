# Octomo MO auth (recommended): user sends the code to 1666-3538.
# Get an API key at https://octomo.octoverse.kr (마이페이지).
OCTOMO_API_KEY=
OCTOMO_SEND_TO=16663538

# Optional Solapi MT auth (service sends SMS). Unused while Octomo is enabled.
# SMS_PROVIDER=solapi
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=
