
# PostgreSQL password used by Docker Compose.
DB_PASSWORD=

# SQLAlchemy connection string used by FastAPI and Alembic.



CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_PHONE_NUMBER=
OPENAI_API_KEY=
CLAWOPS_AGENT_ID=

PUBLIC_BASE_URL=https://flashily-civil-mockup.ngrok-free.dev
CLAWOPS_WEBHOOK_SIGNING_SECRET=


OCTOMO_API_KEY=
OCTOMO_SEND_TO=16663538

# Authentication. Set JWT_SECRET to a long random value in production.
JWT_SECRET=
# ClawOps account-owned 070 number used to send verification SMS messages.
CLAWOPS_SMS_FROM=
# Never enable this in production. When true, the API response exposes the OTP.
SMS_EXPOSE_DEV_CODE=false

# ClawOps PSTN (070 outbound).
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_PHONE_NUMBER=
# Public URL ClawOps uses to POST transcript webhooks, e.g. https://xxxx.ngrok.app
PUBLIC_BASE_URL=
CLAWOPS_WEBHOOK_SIGNING_SECRET=

# Voice pipeline — same keys as ai/.env. The API also loads ../ai/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
STT_ENDPOINTING_MS=400
STT_UTTERANCE_END_MS=1200
ELEVENLABS_API_KEY=
# Premade Theo. To use a cloned voice, paste that voice id here (overrides scenario).
ELEVENLABS_VOICE_ID=CxErO97xpQgQXYmapDKX
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# 0.3–0.45 = more human variation. 0.7+ = flat TTS.
ELEVENLABS_STABILITY=0.38

# 동적 시나리오 생성의 기본 유형 힌트
CALL_SCENARIO=voice_phishing_training
# 통화 시작마다 AI가 CALL_SCENARIO를 바탕으로 새 시나리오를 생성합니다.
DYNAMIC_SCENARIO=true
SCENARIO_GENERATOR_MODEL=gpt-4o-mini
SCENARIO_REVIEW_MODEL=gpt-4o-mini
