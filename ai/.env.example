# Copy to .env and fill in real keys. Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=
# Premade voices work on the free plan. Library voices return 402.
# Korean default (Theo, warm call-center): CxErO97xpQgQXYmapDKX
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# 0.3–0.45 sounds more human. Cloned voice id in ELEVENLABS_VOICE_ID overrides Theo.
# pcm_24000 is easy to play locally and close to telephony PCM.
# Swap to ulaw_8000 later for Twilio Media Streams.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_SAMPLE_RATE=24000

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
STT_SAMPLE_RATE=16000
STT_ENDPOINTING_MS=400
