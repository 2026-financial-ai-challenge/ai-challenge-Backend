# Octomo MO auth: user sends the code to 1666-3538.
# Get an API key at https://octomo.octoverse.kr (마이페이지).
OCTOMO_API_KEY=
OCTOMO_SEND_TO=16663538

# ClawOps PSTN (070 outbound).
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_PHONE_NUMBER=
# Public URL ClawOps uses to POST transcript webhooks, e.g. https://xxxx.ngrok.app
PUBLIC_BASE_URL=
CLAWOPS_WEBHOOK_SIGNING_SECRET=

# Voice pipeline — same keys as ai/.env. The API also loads ../ai/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ko
STT_ENDPOINTING_MS=400
STT_UTTERANCE_END_MS=1200
ELEVENLABS_API_KEY=
# Premade Theo. To use a cloned voice, paste that voice id here (overrides scenario).
ELEVENLABS_VOICE_ID=CxErO97xpQgQXYmapDKX
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# 0.3–0.45 = more human variation. 0.7+ = flat TTS.
ELEVENLABS_STABILITY=0.38

# institution_impersonation | card_payment_fraud | loan_offer
CALL_SCENARIO=institution_impersonation
